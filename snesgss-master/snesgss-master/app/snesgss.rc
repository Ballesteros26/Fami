// Windows resources: the original editor's icon and version information.
#include <winver.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,51,0,0
PRODUCTVERSION 1,51,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "SNES Game Sound System"
			VALUE "FileVersion", "1.51"
			VALUE "ProductName", "SNES GSS"
			VALUE "ProductVersion", "1.51"
			VALUE "OriginalFilename", "snesgss.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
