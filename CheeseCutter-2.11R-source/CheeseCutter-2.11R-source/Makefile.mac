BREW_PREFIX ?= $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)
LDC_PREFIX ?= $(shell brew --prefix ldc 2>/dev/null || echo $(BREW_PREFIX)/opt/ldc)
SDL2_PREFIX ?= $(shell brew --prefix sdl2 2>/dev/null || brew --prefix sdl2-compat 2>/dev/null || echo $(BREW_PREFIX))
SDL3_PREFIX ?= $(shell brew --prefix sdl3 2>/dev/null || echo $(BREW_PREFIX))
MACOSX_DEPLOYMENT_TARGET ?= 26.0
export MACOSX_DEPLOYMENT_TARGET
LIBS=$(LDC_PREFIX)/lib/libphobos2-ldc.a $(LDC_PREFIX)/lib/libdruntime-ldc.a -lc++ -L$(SDL2_PREFIX)/lib -lSDL2
FRAMEWORKS=-framework Foundation
COMFLAGS=-mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) -g
VERSION:=$(strip $(shell cat VERSION))
DLINK=$(COMFLAGS)
DFLAGS=-d-version=DerelictSDL2_Static -I./src -J. -J./src/c64 -J./src/font
CFLAGS=$(COMFLAGS)
CXXFLAGS=$(CFLAGS) -I./src -O2
LDFLAGS=-rpath,@executable_path/../Frameworks
COMPILE.d = $(DC) $(DFLAGS) -d -O2 -c -of=$@ 
DC=ldc2
EXE=
TARGET=ccutter
TEST_TARGET=build/tests/ccutter-regression
ICON_SOURCE=icons/cc2048.png
ICON_SCRIPT=scripts/generate_desktop_icons.py
ICON_OUTPUT_ROOT=build/desktop-icons
MAC_APP_ICON=$(ICON_OUTPUT_ROOT)/macos/ct.icns
SOURCE_RELEASE_SCRIPT=scripts/create_source_release.py
SOURCE_RELEASE_OUTPUT=build/release

include Makefile.objects.mk

.PHONY: test app desktop-icons source-release linux-build-kit verify-source-release verify-linux-build-kit

test: src/c64/player.bin tests/fixtures/r2d-minimal.ct
	mkdir -p build/tests
	$(DC) -g $(DFLAGS) -d -i -of=$(TEST_TARGET) tests/main.d \
		-L-L$(SDL2_PREFIX)/lib -L-lSDL2
	$(TEST_TARGET)

$(TARGET): $(C64OBJS) $(OBJS) $(CXX_OBJS)
	$(CC) $(DLINK) -Wl,$(LDFLAGS) -o $(TARGET) $(OBJS) $(CXX_OBJS) $(LIBS) $(FRAMEWORKS)

.cpp.o : $(CXX_SRCS)
	$(CXX) $(CXXFLAGS) -c $< -o $@

.c.o : $(C_SRCS)
	$(CC) $(CFLAGS) -c $< -o $@

ct: $(C64OBJS) $(CTOBJS)

ct2util: $(C64OBJS) $(UTILOBJS)
	$(CC) $(DLINK) -o $@ $(UTILOBJS) $(LIBS)

c64: $(C64OBJS)

all: c64 $(OBJS) $(CXX_OBJS) ct2util ct $(TARGET)

desktop-icons: $(MAC_APP_ICON)

$(MAC_APP_ICON): $(ICON_SOURCE) $(ICON_SCRIPT)
	python3 $(ICON_SCRIPT) --source $(ICON_SOURCE) --output $(ICON_OUTPUT_ROOT) --platform all --verify

source-release:
	python3 $(SOURCE_RELEASE_SCRIPT) --project-root . --output $(SOURCE_RELEASE_OUTPUT) --kind source

linux-build-kit:
	python3 $(SOURCE_RELEASE_SCRIPT) --project-root . --output $(SOURCE_RELEASE_OUTPUT) --kind linux-build-kit

verify-source-release:
	python3 $(SOURCE_RELEASE_SCRIPT) --project-root . --output $(SOURCE_RELEASE_OUTPUT) --kind verify-source

verify-linux-build-kit:
	python3 $(SOURCE_RELEASE_SCRIPT) --project-root . --output $(SOURCE_RELEASE_OUTPUT) --kind verify-linux-kit

app: desktop-icons all
	rm -rf CheeseCutter.app
	mkdir -p CheeseCutter.app/Contents/Frameworks
	mkdir -p CheeseCutter.app/Contents/MacOS
	cp -r arch/MacOS/Contents CheeseCutter.app
	mkdir -p CheeseCutter.app/Contents/Resources
	cp $(MAC_APP_ICON) CheeseCutter.app/Contents/Resources/ct.icns
	rm -f CheeseCutter.app/Contents/.DS_Store
	sed -e 's/@APP_VERSION@/$(VERSION)/g' \
		-e 's/@MACOSX_DEPLOYMENT_TARGET@/$(MACOSX_DEPLOYMENT_TARGET)/g' \
		arch/MacOS/Contents/Info.plist > CheeseCutter.app/Contents/Info.plist
	cp $(TARGET) CheeseCutter.app/Contents/MacOS
	cp -L $(SDL2_PREFIX)/lib/libSDL2-2.0.0.dylib CheeseCutter.app/Contents/Frameworks/libSDL2-2.0.0.dylib
	cp -L $(SDL3_PREFIX)/lib/libSDL3.0.dylib CheeseCutter.app/Contents/Frameworks/libSDL3.dylib
	chmod u+w CheeseCutter.app/Contents/Frameworks/*.dylib
	install_name_tool -change $(SDL2_PREFIX)/lib/libSDL2-2.0.0.dylib @rpath/libSDL2-2.0.0.dylib CheeseCutter.app/Contents/MacOS/$(TARGET)
	install_name_tool -id @rpath/libSDL2-2.0.0.dylib CheeseCutter.app/Contents/Frameworks/libSDL2-2.0.0.dylib
	install_name_tool -id @rpath/libSDL3.dylib CheeseCutter.app/Contents/Frameworks/libSDL3.dylib
	strip -x CheeseCutter.app/Contents/MacOS/$(TARGET)
	codesign --force --sign - CheeseCutter.app/Contents/Frameworks/libSDL2-2.0.0.dylib
	codesign --force --sign - CheeseCutter.app/Contents/Frameworks/libSDL3.dylib
	codesign --force --sign - CheeseCutter.app/Contents/MacOS/$(TARGET)
	codesign --force --sign - CheeseCutter.app

release: all
	strip ccutter$(EXE)
	strip ct2util$(EXE)
	$(MAKE) -f Makefile.mac app

dist:	release
	rm -rf dist
	rm -rf CheeseCutter_$(VERSION).dmg
	arch/makedmg.sh

clean: 
	rm -f *.o *~ resid/*.o resid-fp/*.o ccutter ct2util \
		$(C64OBJS) $(OBJS) $(CTOBJS) $(CXX_OBJS) $(UTILOBJS)
	rm -rf build CheeseCutter.app
	find . -path './.git' -prune -o -type f -name '.DS_Store' -exec rm -f {} +

dclean: clean
	rm -rf dist
	rm -rf CheeseCutter_$(VERSION).dmg


tar:
	git archive master --prefix=cheesecutter-$(VERSION)/ | bzip2 > cheesecutter-$(VERSION)-macosx-src.tar.bz2
# --------------------------------------------------------------------------------

src/c64/player.bin: src/c64/player_v4.acme
	acme -f cbm --outfile $@ $<

src/ct/base.o: src/c64/player.bin
src/ui/ui.o: src/ui/help.o
src/com/fb.o src/ct2util.o: VERSION src/com/appversion.d

%.o: %.d
	$(COMPILE.d) $<
